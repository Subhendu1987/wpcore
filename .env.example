# Server
PORT=3000
API_KEY=replace-with-a-long-random-secret
# Optional: public API URL used when refreshing the Postman collection.
PUBLIC_BASE_URL=http://localhost:3000

# Where the WhatsApp session is persisted (stays logged in after first QR scan)
SESSION_DIR=./.wwebjs_auth

# Outbound webhook: incoming WhatsApp messages are POSTed (JSON) to this URL.
# Leave empty to disable forwarding.
WEBHOOK_URL=
